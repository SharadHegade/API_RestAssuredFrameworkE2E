<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Suite" parallel="tests" thread-count="5">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg" />
    </listeners>

    <test name="Auth and Login Tests">
        <classes>
            <class name="com.api.tests.LoginApiTest3_SOM" />
        </classes>
    </test>

    <test name="Get Profile API Tests">
        <classes>
            <class name="com.api.tests.GetProfileRequestTest" />
        </classes>
    </test>

    <test name="Forgot Password API Tests">
        <classes>
            <class name="com.api.tests.ForgotPasswordTest" />
        </classes>
    </test>

</suite>

